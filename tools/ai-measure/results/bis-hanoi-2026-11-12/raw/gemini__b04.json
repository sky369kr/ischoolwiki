              "groundingSupports": [
                {
                  "segment": {
                    "endIndex": 195,
                    "text": "Graduates from the **British International School Hanoi (BIS Hanoi)** consistently matriculate to world-ranked universities across North America, the United Kingdom, Europe, Asia, and Australasia"
                  },
                  "groundingChunkIndices": [
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 197,
                    "endIndex": 324,
                    "text": "Supported by their International Baccalaureate (IB) Diploma results, alumni regularly receive offers from top-tier institutions"
                  },
                  "groundingChunkIndices": [
                    1,
                    2
                  ]
                },
                {
                  "segment": {
                    "startIndex": 363,
                    "endIndex": 478,
                    "text": "The United States is traditionally the most popular destination for BIS Hanoi graduates, followed closely by Canada"
                  },
                  "groundingChunkIndices": [
                    1
                  ]
                },
                {
                  "segment": {
                    "startIndex": 482,
                    "endIndex": 674,
                    "text": "**Ivy League & Top Private Universities:** Stanford University, Yale University, Columbia University, Brown University, Duke University, Johns Hopkins University, and New York University (NYU)"
                  },
                  "groundingChunkIndices": [
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 678,
                    "endIndex": 910,
                    "text": "**Public Flagships & Major Colleges:** University of California, Berkeley (UC Berkeley); University of California, Los Angeles (UCLA); University of Texas at Austin; Georgia Institute of Technology; Boston University; Boston College"
                  },
                  "groundingChunkIndices": [
                    3,
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 914,
                    "endIndex": 1008,
                    "text": "**Canada:** University of Toronto, McGill University, and University of British Columbia (UBC)"
                  },
                  "groundingChunkIndices": [
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1039,
                    "endIndex": 1172,
                    "text": "As a British international school, a significant proportion of graduates attend prestigious Russell Group and leading UK institutions"
                  },
                  "groundingChunkIndices": [
                    1
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1176,
                    "endIndex": 1384,
                    "text": "**Oxbridge & London Institutions:** University of Cambridge, Imperial College London, University College London (UCL), London School of Economics and Political Science (LSE), and King’s College London (KCL)"
                  },
                  "groundingChunkIndices": [
                    4,
                    1,
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1388,
                    "endIndex": 1578,
                    "text": "**Other Leading UK Universities:** University of Edinburgh, University of Manchester, University of Warwick, University of Bristol, Durham University, and University of the Arts London (UAL)"
                  },
                  "groundingChunkIndices": [
                    1,
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1613,
                    "endIndex": 1735,
                    "text": "BIS Hanoi students frequently choose specialized European universities, particularly for business, hospitality, and design"
                  },
                  "groundingChunkIndices": [
                    3
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1739,
                    "endIndex": 1880,
                    "text": "**Business & Social Sciences:** Bocconi University (Italy), Erasmus University Rotterdam (Netherlands), University of Amsterdam (Netherlands)"
                  },
                  "groundingChunkIndices": [
                    3,
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1884,
                    "endIndex": 1997,
                    "text": "**Hospitality:** EHL Hospitality Business School (Switzerland), Glion Institute of Higher Education (Switzerland)"
                  },
                  "groundingChunkIndices": [
                    3
                  ]
                },
                {
                  "segment": {
                    "startIndex": 2001,
                    "endIndex": 2080,
                    "text": "**Other Notable Institutions:** KU Leuven (Belgium), Aalto University (Finland)"
                  },
                  "groundingChunkIndices": [
                    3
                  ]
                },
                {
                  "segment": {
                    "startIndex": 2101,
                    "endIndex": 2190,
                    "text": "Students seeking top Asian universities often matriculate into world-ranked research hubs"
                  },
                  "groundingChunkIndices": [
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 2194,
                    "endIndex": 2346,
                    "text": "**Hong Kong:** The University of Hong Kong (HKU), Hong Kong University of Science and Technology (HKUST), and The Chinese University of Hong Kong (CUHK)"
                  },
                  "groundingChunkIndices": [
                    3,
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 2350,
                    "endIndex": 2446,
                    "text": "**Singapore:** National University of Singapore (NUS) and Nanyang Technological University (NTU)"
                  },
                  "groundingChunkIndices": [
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 2450,
                    "endIndex": 2522,
                    "text": "**South Korea:** KAIST, Seoul National University, and Yonsei University"
                  },
                  "groundingChunkIndices": [
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 2526,
                    "endIndex": 2619,
                    "text": "**Japan:** Waseda University, Sophia University, and International Christian University (ICU)"
                  },
                  "groundingChunkIndices": [
                    3,
                    5
                  ]
                },
                {
                  "segment": {
                    "startIndex": 2738,
                    "endIndex": 2893,
                    "text": "The University of Melbourne, The University of Sydney, The University of New South Wales (UNSW Sydney), Monash University, and The University of Queensland"
                  },
                  "groundingChunkIndices": [
                    3,
                    4,
                    0
                  ]
                }
              ],
