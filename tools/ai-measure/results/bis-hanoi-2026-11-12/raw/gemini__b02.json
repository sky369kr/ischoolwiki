                {
                  "segment": {
                    "endIndex": 213,
                    "text": "The British International School Hanoi (BIS Hanoi) consistently outperforms both global and UK averages in both the **International Baccalaureate Diploma Programme (IBDP)** and the **Cambridge IGCSE** examinations"
                  },
                  "groundingChunkIndices": [
                    0,
                    1
                  ]
                },
                {
                  "segment": {
                    "startIndex": 294,
                    "endIndex": 404,
                    "text": "BIS Hanoi has surpassed the global average point score for consecutive years since its first graduating cohort"
                  },
                  "groundingChunkIndices": [
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 433,
                    "endIndex": 526,
                    "text": "**2026:** **35.11 – 35.15 points** (significantly higher than the global average of ~30.88)"
                  },
                  "groundingChunkIndices": [
                    2,
                    3
                  ]
                },
                {
                  "segment": {
                    "startIndex": 532,
                    "endIndex": 582,
                    "text": "**2025:** **33.24 points** (global average: 30.58)"
                  },
                  "groundingChunkIndices": [
                    0
                  ]
                },
                {
                  "segment": {
                    "startIndex": 588,
                    "endIndex": 636,
                    "text": "**2024:** **34.7 points** (global average: 30.3)"
                  },
                  "groundingChunkIndices": [
                    4
                  ]
                },
                {
                  "segment": {
                    "startIndex": 687,
                    "endIndex": 792,
                    "text": "More than **1 in 7 students** typically achieve **40+ points** (placing them in the top echelon globally)"
                  },
                  "groundingChunkIndices": [
                    2,
                    4
                  ]
                },
                {
                  "segment": {
                    "startIndex": 798,
                    "endIndex": 886,
                    "text": "In recent cohorts, students have achieved the maximum possible score of **45/45 points**"
                  },
                  "groundingChunkIndices": [
                    2,
                    3
                  ]
                },
                {
                  "segment": {
                    "startIndex": 890,
                    "endIndex": 983,
                    "text": "**Pass Rate:** Consistently near **98%–100%**, compared to the global average of around 80%"
                  },
                  "groundingChunkIndices": [
                    4
                  ]
                },
                {
                  "segment": {
                    "startIndex": 987,
                    "endIndex": 1146,
                    "text": "**IB Bilingual Diploma:** Approximately **63% – 65%** of graduating cohorts achieve the IB Bilingual Diploma, demonstrating academic fluency in two languages"
                  },
                  "groundingChunkIndices": [
                    5,
                    4
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1219,
                    "endIndex": 1317,
                    "text": "BIS Hanoi students regularly achieve results far exceeding typical UK and international benchmarks"
                  },
                  "groundingChunkIndices": [
                    6,
                    1
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1364,
                    "endIndex": 1457,
                    "text": "Around **43% to 46%** of all grades awarded are A\\* or A (compared to the UK average of ~23%)"
                  },
                  "groundingChunkIndices": [
                    6,
                    1
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1463,
                    "endIndex": 1516,
                    "text": "Over 80% of students earn at least one A\\* or A grade"
                  },
                  "groundingChunkIndices": [
                    1
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1562,
                    "endIndex": 1659,
                    "text": "Between **85% and 89%** of all grades awarded are A\\* to C (compared to the UK benchmark of ~55%)"
                  },
                  "groundingChunkIndices": [
                    6,
                    1
                  ]
                },
                {
                  "segment": {
                    "startIndex": 1693,
                    "endIndex": 1899,
                    "text": "Multiple BIS Hanoi students have earned Cambridge Assessment International Education’s **“Top in the World”** awards for achieving the highest worldwide marks (100%) in subjects like IGCSE Mathematics"
